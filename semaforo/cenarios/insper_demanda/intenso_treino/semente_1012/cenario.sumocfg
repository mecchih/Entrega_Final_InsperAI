<?xml version="1.0" encoding="UTF-8"?>
<!-- derivado de semaforo/cenarios/insper/osm.sumocfg: mesmas opcoes de simulacao -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../../../insper/osm.net.xml.gz" />
        <route-files value="rotas.rou.xml" />
        <additional-files value="../../../insper/osm.poly.xml.gz" />
    </input>
    <processing>
        <ignore-route-errors value="true" />
        <tls.actuated.jam-threshold value="30" />
    </processing>
    <routing>
        <device.rerouting.adaptation-steps value="18" />
        <device.rerouting.adaptation-interval value="10" />
    </routing>
    <report>
        <verbose value="true" />
        <duration-log.statistics value="true" />
        <no-step-log value="true" />
    </report>
    <gui_only>
        <gui-settings-file value="../../../insper/osm.view.xml" />
    </gui_only>
</sumoConfiguration>